<launch>
  <!-- ctrl_v1 速度 PID + 位置反馈控制器（直接订阅 /planner_cmd，无需 planner_adapter）
       实机：odom_topic 默认 /Odometry（FAST-LIO）
       仿真：odom_topic:=/mavros/local_position/odom（否则里程计回调不触发，
             飞机悬停在起飞高度永远不进规划跟踪） -->
  <arg name="odom_topic" default="/Odometry"/>
  <arg name="takeoff_height" default="1.0"/>
  <arg name="pid_enabled" default="true"/>
  <arg name="pid_kp" default="1.3"/>
  <arg name="pid_ki" default="0.0"/>
  <arg name="pid_kd" default="0.0"/>
  <arg name="pid_integral_limit" default="1.0"/>
  <arg name="pid_output_limit" default="1.5"/>
  <arg name="position_kp" default="0.8"/>
  <arg name="position_error_limit" default="1.0"/>

  <node pkg="planner_ctrl" name="ctrl_v1" type="ctrl_v1" output="screen">
    <remap from="/Odometry" to="$(arg odom_topic)"/>
    <param name="takeoff_height" value="$(arg takeoff_height)" type="double"/>
    <param name="pid_enabled" value="$(arg pid_enabled)" type="bool"/>
    <param name="pid_kp" value="$(arg pid_kp)" type="double"/>
    <param name="pid_ki" value="$(arg pid_ki)" type="double"/>
    <param name="pid_kd" value="$(arg pid_kd)" type="double"/>
    <param name="pid_integral_limit" value="$(arg pid_integral_limit)" type="double"/>
    <param name="pid_output_limit" value="$(arg pid_output_limit)" type="double"/>
    <param name="position_kp" value="$(arg position_kp)" type="double"/>
    <param name="position_error_limit" value="$(arg position_error_limit)" type="double"/>
  </node>
</launch>
