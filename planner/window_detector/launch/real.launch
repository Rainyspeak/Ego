<launch>

  <arg name="cloud_topic" default="/cloud_registered"/>
  <arg name="odom_topic" default="/Odometry"/>
  <arg name="cloud_frame" default="camera_init"/>
  <arg name="start_rviz" default="false"/>

  <node pkg="window_detector" type="window_detector_node" name="window_detector" output="screen">
    <remap from="~cloud" to="$(arg cloud_topic)"/>
    <remap from="~odom" to="$(arg odom_topic)"/>

    <!-- 简版 EGO 接入：锁定期间把目标持续发到 /move_base_simple/goal（与 RViz 2D Nav Goal
         同链，经 waypoint_generator 单航点下发 EGO 规划执行）。
         goal_exit_dist: goal 落在框心后方（沿穿框法向）的距离。0=恰为框心（会在框平面
         减速悬停）；>0 越过框平面保证"穿过"，建议 0.3–1.0 m -->
    <param name="publish_goal" value="true"/>
    <param name="goal_topic" value="/move_base_simple/goal"/>
    <param name="goal_exit_dist" value="0.5"/>
    <!-- 自定义航点高度：-1=跟随检测框心高度；改成 ≥0 的值（如 1.2）即强制该高度 -->
    <param name="goal_z" value="-1.0"/>

    <!-- 按实际框标定（文档 5 节调参指南）：
    <param name="min_frame_size" value="0.85"/>
    <param name="max_frame_size" value="1.5"/>
    <param name="target_size" value="1.0"/>
    <param name="target_search_direction_x" value="1.0"/>
    <param name="target_search_direction_y" value="0.0"/>
    <param name="target_search_direction_z" value="0.0"/>
    -->
  </node>

  <node if="$(arg start_rviz)" pkg="rviz" type="rviz" name="rviz"
      args="-d $(find window_detector)/rviz/window_detector.rviz -f $(arg cloud_frame)"/>
</launch>
