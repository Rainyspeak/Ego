<launch>

  <!-- 实机稠密点云版：node 为 forecast_searching_real（入口预筛 + 稠密参数档），
       仿真稀疏云版是 forecast_searching_sim（forecast_searching_sim.launch）。
       两者话题/服务/参数名完全一致，可互换。 -->
  <arg name="cloud_topic" default="/cloud_registered"/>
  <arg name="odom_topic" default="/Odometry"/>
  <arg name="publish_goal" default="true"/>
  <!-- 注视三航点批量入队模式：锁定期间把本框 [P1,P2,P3] 一组发到 path_out_topic
       （path_manager enqueue_batch，队尾原位更新/新框整批追加）。开启时 goal
       自动禁用（互斥） -->
  <arg name="publish_path" default="false"/>
  <arg name="path_out_topic" default="/path_manager/enqueue_path"/>
  <!-- 已知环径约束（圆环精化固定半径只解圆心/法向，斜视角/短弧强几何约束；
       0=关闭自由拟合。实飞环径不同时改此值） -->
  <arg name="circle_known_diameter" default="2.15"/>
  <arg name="goal_exit_dist" default="1.3"/>
  <!-- 自定义航点高度：-1=跟随检测框心高度；改成 ≥0 的值（如 1.2）即强制该高度 -->
  <arg name="goal_z" default="1.0"/>

  <!-- ===== 稠密云密度档（仿真版为稀疏云放宽值，此处收紧）=====
       voxel_leaf      检测体素(m)：0.08 计算量比 0.05 降约 60%，2.15 m 环单圈
                       ~85 个体素点仍够圆拟合；锁不上回调 0.05
       min_cluster_points 最小簇点数：稠密云碎片小簇大量存在，20 会满屏误检；
                       0.08 体素下近距开弧（50-70% 覆盖）约 40-60 点，60 拒碎片不伤开弧
       min_plane_inliers   平面最少内点：稠密云下真框内点数百起，30 拒薄碎片
       cluster_tol     聚类连通阈值(m)：稠密云下 0.4 会把框与墙/支架黏成一大簇，
                       收回到 0.25；仍黏连时再调小 -->
  <arg name="voxel_leaf" default="0.08"/>
  <arg name="min_cluster_points" default="60"/>
  <arg name="min_plane_inliers" default="30"/>
  <arg name="cluster_tol" default="0.25"/>
  <!-- 近距(约<1.5 m)时框近弧落入 min_range 盲区，中心估计逐帧跳变导致候选窗反复清空锁不上：
       缩小 min_range 保留更多近弧点 + 放宽一致性阈值让 EMA 收敛。
       center_consistency 0.9：2.5-3.5 m 中距上圆环中心估计跳变可达 ±0.7，0.6 会反复清窗
       （run7 实测卡死点）；锁定初值取窗口中位数，放宽窗口不引入偏差 -->
  <arg name="min_range" default="0.35"/>
  <arg name="center_consistency" default="0.9"/>
  <arg name="lock_count" default="4"/>
  <!-- 检测范围与几何窗：
       max_range     ROI 远距(m)：超出此距离的框不检测（入口预筛再留 1 m 余量）
       视角/尺寸窗    max_view_angle_deg=120、min/max_frame_size=1.0/3.0 -->
  <arg name="max_range" default="6.0"/>
  <arg name="max_view_angle_deg" default="120.0"/>
  <arg name="min_frame_size" default="1.0"/>
  <arg name="max_frame_size" default="3"/>
  <!-- 实机单帧已稠密，累积只补近弧/遮挡轮廓（仿真版靠 1 s 长窗补稀疏单帧）；
       窗口内机体弧长超 accumulate_max_dist 时自动收缩 -->
  <arg name="accumulate_time" default="0.5"/>
  <!-- 骨架环检测（方向 A）总开关：A/B 定位方框中心偏移回归用 -->
  <arg name="enable_skeleton" default="true"/>

  <!-- 无先验时两框同现 ROI 不再 AMBIGUOUS 死锁：就近优先，保证 goal 持续发布；
       switch_margin 为切换余量——其余框须比当前选中框近这么多才切换（防逐帧跳变） -->
  <arg name="prefer_nearest_on_ambiguous" default="true"/>
  <arg name="nearest_switch_margin" default="0.5"/>

  <!-- 已穿越框过滤：越过框平面后拉黑该框——不再锁定、不参与多框歧义计数，
       否则 Mid360 后视重检+法向翻转会把 goal 掉到框另一侧，来回穿框死循环。
       reset 服务会清空拉黑记录 -->
  <arg name="enable_traversed_filter" default="true"/>
  <arg name="traversed_match_dist" default="1.5"/>   <!-- 检测中心与已穿越框的匹配半径(m)：
       边缘视角中心估计可偏 >1.175(框半径)，过小会把已穿框当新目标重新锁定(run9 实测幽灵回拉) -->
  <arg name="traversed_mark_clear" default="0.15"/>  <!-- 沿法向越过平面的判定距离(m) -->
  <arg name="traversed_axis_margin" default="0.5"/>  <!-- 横向偏差容许余量(m)，绕框侧飞不算穿越 -->

  <node pkg="forecast_searching" type="forecast_searching_real" name="forecast_searching" output="screen">
    <remap from="~cloud" to="$(arg cloud_topic)"/>
    <remap from="~odom" to="$(arg odom_topic)"/>
    <param name="publish_goal" value="$(arg publish_goal)"/>
    <param name="publish_path" value="$(arg publish_path)"/>
    <param name="path_out_topic" value="$(arg path_out_topic)"/>
    <param name="circle_known_diameter" value="$(arg circle_known_diameter)"/>
    <param name="goal_exit_dist" value="$(arg goal_exit_dist)"/>
    <param name="goal_z" value="$(arg goal_z)"/>
    <param name="voxel_leaf" value="$(arg voxel_leaf)"/>
    <param name="min_cluster_points" value="$(arg min_cluster_points)"/>
    <param name="min_plane_inliers" value="$(arg min_plane_inliers)"/>
    <param name="min_range" value="$(arg min_range)"/>
    <param name="center_consistency" value="$(arg center_consistency)"/>
    <param name="lock_count" value="$(arg lock_count)"/>
    <!-- 预测模型（Holt 阻尼趋势，三航点组刚性预测）：0 = 关（纯 EMA） -->
    <param name="trend_beta" value="0.3"/>
    <param name="trend_damping" value="0.85"/>
    <param name="max_range" value="$(arg max_range)"/>
    <param name="cluster_tol" value="$(arg cluster_tol)"/>
    <param name="max_view_angle_deg" value="$(arg max_view_angle_deg)"/>
    <param name="min_frame_size" value="$(arg min_frame_size)"/>
    <param name="max_frame_size" value="$(arg max_frame_size)"/>
    <param name="accumulate_time" value="$(arg accumulate_time)"/>
    <param name="enable_skeleton" value="$(arg enable_skeleton)"/>
    <param name="prefer_nearest_on_ambiguous" value="$(arg prefer_nearest_on_ambiguous)"/>
    <param name="nearest_switch_margin" value="$(arg nearest_switch_margin)"/>
    <param name="enable_traversed_filter" value="$(arg enable_traversed_filter)"/>
    <param name="traversed_match_dist" value="$(arg traversed_match_dist)"/>
    <param name="traversed_mark_clear" value="$(arg traversed_mark_clear)"/>
    <param name="traversed_axis_margin" value="$(arg traversed_axis_margin)"/>
  </node>
</launch>
